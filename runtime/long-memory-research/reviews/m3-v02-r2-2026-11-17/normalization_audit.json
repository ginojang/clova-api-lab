    "lines_99_107": [
      "export function didSourceWhy(d: Record<string, unknown>, turns: Array<{ turn_index: number; speaker: string }>, s6: Record<string, string>): string | null {",
      "    const ti = d.turn_index;",
      "    if (typeof ti !== 'number' || !Number.isInteger(ti)) return 'did_no_source';   // 정수만(bool·실수 = 원천 없음 · 계약 v0.009)",
      "    if (!turns.some((t) => t.turn_index === ti && t.speaker === 'assistant')) return 'did_source_bad';",
      "    const v = s6[String(ti)] ?? 'none';                            // 값 없음 = none(판정 안 함)",
      "    if (v === 'pass' || v === 'unknown' || v === 'none') return null;   // 계약 v0.009 허용 셋",
      "    if (v === 'fix' || v === 'block') return 'did_source_bad';",
      "    if (v === 'lookup_error') return 'did_s6_lookup_error';           // 판정을 못 읽었다 ≠ unknown(실제 block 일 수 있다 · 보류)",
      "    return 'did_s6_unexpected';                                      // 목록 밖 값 = 닫힌 쪽(클로버 9bbfa0fdab)"
    ]
  },

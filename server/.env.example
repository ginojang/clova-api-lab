# server/.env — 백엔드 전용. 실제 server/.env 는 커밋 금지(.gitignore 처리됨).
PORT=3600

# CLOVA Studio 자격증명
CLOVA_API_KEY=
CLOVA_APIGW_API_KEY=
CLOVA_BASE_URL=https://clovastudio.stream.ntruss.com

# 인증 방식: legacy(X-NCP-* 두 키) | bearer(Authorization: Bearer, 현행 v3)
CLOVA_AUTH_MODE=legacy
# 엔드포인트 경로 override (미설정 시 모드별 기본값: legacy=/testapp/v1/chat-completions, bearer=/v3/chat-completions)
# CLOVA_CHAT_PATH=

# (배포 시) spitfire PostgreSQL — 로그 영속화용. 실제 값은 hellcat 의 server/.env 에만.
# PGHOST=192.168.0.2
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=

# 하네스 테스트 화면(백엔드 전용). 접속 코드는 32자 이상 무작위 값, 파일 권한 600.
# CLOVA_LAB_ACCESS_TOKEN_FILE=/absolute/path/to/harness-access
# CLOVA_RUNTIME_DIR=/absolute/path/to/runtime/clova
# CLOVA_LAB_DIR=/absolute/path/to/private-test-workspaces

# 추가 API는 하네스 ② 전용. 발급받은 키를 권한 600 파일에 저장한 뒤 설정합니다.
# npm run configure:mode2 -- --init
# GROQ_API_KEY_FILE=/home/gino/.config/elda-clova/providers/groq.key
# OPENROUTER_API_KEY_FILE=/home/gino/.config/elda-clova/providers/openrouter.key
# ZAI_API_KEY_FILE=/home/gino/.config/elda-clova/providers/zai.key
